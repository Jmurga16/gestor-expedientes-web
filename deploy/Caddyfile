{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	handle_path /api/* {
		reverse_proxy {$API_UPSTREAM:traza-api:8080}
	}

	handle_path /almacen/* {
		@lectura {
			method GET HEAD
			path /traza/workflow-bpmn/* /traza/demanda-bpmn/* /traza/demanda-imagen/*
		}
		handle @lectura {
			reverse_proxy {$ALMACEN_UPSTREAM:traza-almacen:10000} {
				header_up -Authorization
				header_up -Cookie
			}
		}
		handle {
			respond 404
		}
	}

	handle {
		root * /srv
		@inmutables path *.js *.css
		header @inmutables Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
